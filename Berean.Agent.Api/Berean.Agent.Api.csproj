<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Berean.Agent.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Berean.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference your Common.Core project -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <ProjectReference Include="..\Berean.Core\Berean.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>


  <ItemGroup>
    <Using Include="Berean.Core.Agent" />
    <Using Include="Berean.Core.Routing" />
    <Using Include="Berean.Core.Retrieval" />
    <Using Include="Berean.Core.Indexing" />
    <Using Include="Berean.Core.Tools" />
    <Using Include="Berean.Core.Resources" />
    <Using Include="Berean.Core.Llm" />
  </ItemGroup>

</Project>