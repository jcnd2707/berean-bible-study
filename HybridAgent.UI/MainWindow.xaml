<Window x:Class="HybridAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hybrid AI Agent" Height="720" Width="1100"
        MinHeight="540" MinWidth="800"
        Background="#0D0D0F"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep"       Color="#0D0D0F"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#13131A"/>
        <SolidColorBrush x:Key="BgCard"       Color="#1A1A26"/>
        <SolidColorBrush x:Key="BgInput"      Color="#111118"/>
        <SolidColorBrush x:Key="Border"       Color="#2A2A3E"/>
        <SolidColorBrush x:Key="Accent"       Color="#5B8DEF"/>
        <SolidColorBrush x:Key="AccentGlow"   Color="#3A6BD4"/>
        <SolidColorBrush x:Key="TxtPrimary"   Color="#E8E8F0"/>
        <SolidColorBrush x:Key="TxtSecondary" Color="#7878A0"/>
        <SolidColorBrush x:Key="TxtMuted"     Color="#44445A"/>
        <SolidColorBrush x:Key="Green"        Color="#4ADE80"/>
        <SolidColorBrush x:Key="Yellow"       Color="#FBBF24"/>
        <SolidColorBrush x:Key="Red"          Color="#F87171"/>
        <SolidColorBrush x:Key="UserBubble"   Color="#1E2540"/>
        <SolidColorBrush x:Key="AgentBubble"  Color="#161620"/>

        <Style x:Key="AgentButton" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="{StaticResource TxtSecondary}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"  Value="#1E2540"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground"                    Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"  Value="#1A1A2E"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3A3A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource TxtSecondary}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"  Value="#1A1A2E"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E2540"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TxtMuted}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TxtMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A5AC8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#2A2A40"/>
                                <Setter Property="Foreground" Value="{StaticResource TxtMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="6"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,22,20,18"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="◈ HYBRID AI"
                                   Foreground="{StaticResource Accent}"
                                   FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Multi-Domain Agent"
                                   Foreground="{StaticResource TxtMuted}"
                                   FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="SELECT AGENT"
                           Foreground="{StaticResource TxtMuted}"
                           FontSize="9" Margin="20,16,20,8"/>

                <!-- Agent radio buttons -->
                <StackPanel Grid.Row="2" Margin="12,0,12,0">
                    <RadioButton x:Name="RbCar" Style="{StaticResource AgentButton}"
                                 IsChecked="True" GroupName="Agent"
                                 Checked="AgentRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="🔧  Car Diagnostics" FontSize="13"/>
                            <TextBlock Text="llama3.2:3b" FontSize="10"
                                       Foreground="{StaticResource TxtMuted}" Margin="22,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbBible" Style="{StaticResource AgentButton}"
                                 GroupName="Agent" Checked="AgentRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="📖  Bible Research" FontSize="13"/>
                            <TextBlock Text="llama3.2:3b" FontSize="10"
                                       Foreground="{StaticResource TxtMuted}" Margin="22,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbCSharp" Style="{StaticResource AgentButton}"
                                 GroupName="Agent" Checked="AgentRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="⌨  C# Troubleshoot" FontSize="13"/>
                            <TextBlock Text="deepseek-coder:6.7b" FontSize="10"
                                       Foreground="{StaticResource TxtMuted}" Margin="22,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="3" Height="1"
                        Background="{StaticResource Border}" Margin="12,16,12,16"/>

                <!-- Status panel -->
                <StackPanel Grid.Row="4" Margin="20,0,20,0">
                    <TextBlock Text="STATUS" FontSize="9"
                               Foreground="{StaticResource TxtMuted}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Docs" Foreground="{StaticResource TxtMuted}" FontSize="11"/>
                        <TextBlock x:Name="TxtDocsPath" Grid.Column="1"
                                   Text="docs/car"
                                   Foreground="{StaticResource TxtSecondary}"
                                   FontSize="11" TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cloud" Foreground="{StaticResource TxtMuted}" FontSize="11"/>
                        <TextBlock x:Name="TxtCloudStatus" Grid.Column="1"
                                   Text="checking…"
                                   FontSize="11" TextAlignment="Right"/>
                    </Grid>
                    <Border x:Name="InitBadge"
                            Background="#1A2010" BorderBrush="#2E4A1A"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,5" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtInitStatus"
                                   Text="⬤  Connecting…"
                                   Foreground="{StaticResource Yellow}"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Row="6" Margin="12,0,12,0">
                    <Button x:Name="BtnVerdict"
                            Style="{StaticResource ActionButton}"
                            Content="⚡  Verdict  (cloud)"
                            Margin="0,0,0,6" Height="36"
                            IsEnabled="False"
                            Click="BtnVerdict_Click"/>
                    <Button x:Name="BtnReset"
                            Style="{StaticResource ActionButton}"
                            Content="↺  Reset conversation"
                            Height="36" IsEnabled="False"
                            Click="BtnReset_Click"/>
                </StackPanel>

                <Border Grid.Row="7" Height="16"/>
            </Grid>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAgentTitle" Text="Car Diagnostics"
                                   Foreground="{StaticResource TxtPrimary}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <Border x:Name="ModelBadge"
                                Background="#1A1A30" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,3" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtModelBadge" Text="llama3.2:3b"
                                       Foreground="{StaticResource Accent}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtMessageCount"
                               Text="0 messages"
                               Foreground="{StaticResource TxtMuted}"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                          Background="{StaticResource BgDeep}"
                          Padding="0,8,0,8">
                <StackPanel x:Name="ChatPanel" Margin="24,0"/>
            </ScrollViewer>

            <!-- Input area -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource BgInput}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="7" Padding="14,0">
                        <TextBox x:Name="InputBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TxtPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalAlignment="Center"
                                 MinHeight="42" MaxHeight="120"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 IsEnabled="False"
                                 KeyDown="InputBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                    <Button x:Name="BtnSend" Grid.Column="1"
                            Style="{StaticResource SendButton}"
                            Content="Send →" Width="90" Height="42"
                            Margin="10,0,0,0" IsEnabled="False"
                            Click="BtnSend_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
