{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5050",
  "OpenAI": {
    "ApiKey": ""
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "EmbeddingModel": "mxbai-embed-large"
  },
  "Agents": {
    "BibleAgent": {
      "RagDbPath": "D:\\Bible Study\\bible-docs\\index\\bible.rag.db",
      "ModulesRootPath": "D:\\Bible Study\\bible-docs",
      "DictionaryRootPath": "D:\\Bible Study\\bible-docs",
      "AllowedExtensions": [ ".cmtx", ".topx" ],
      "Language": "en",
      "MmrLambda": 0.6,
      "ResourceApiBaseUrl": "http://localhost:5121",
      "AllowedBibleModules": [ "akjvstrong", "KJV" ],
      "AllowedCommentaryModules": null,
      "TopK": 8,
      "MmrCandidateK": 200,
      "ChunkSize": 400,
      "ChunkOverlap": 100

    },
    "CarAgent": {
      "RagDbPath": "index/car.rag.db",
      "ModulesRootPath": "C:/docs/cars",
      "AllowedExtensions": [ ".pdf", ".txt", ".md" ],
      "Language": "en",
      "TopK": 6,
      "MmrLambda": 0.7,
      "MmrCandidateK": 60
    },
    "CodeAgent": {
      "RagDbPath": "index/code.rag.db",
      "ModulesRootPath": "C:/docs/code",
      "AllowedExtensions": [ ".pdf", ".txt", ".md", ".cs" ],
      "Language": "en",
      "TopK": 6,
      "MmrLambda": 0.7,
      "MmrCandidateK": 60
    }
  }
